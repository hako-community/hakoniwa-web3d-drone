{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/scene-config.schema.json",
  "title": "Hakoniwa Threejs Scene Config (compact)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "droneTypesPath",
    "drones"
  ],
  "properties": {
    "version": { "type": "string" },
    "format": { "type": "string", "const": "compact" },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["model", "terrain-grid"]
          },
          "enabled": { "type": "boolean", "default": true },
          "model": { "type": "string", "minLength": 1 },
          "terrainGridPath": { "type": "string", "minLength": 1 },
          "pos": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "hpr": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "material": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["elevation", "solid", "wireframe"]
              },
              "color": {},
              "lowColor": {},
              "middleColor": {},
              "highColor": {},
              "wireframe": { "type": "boolean" },
              "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
              "metalness": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "debug": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "grid": { "type": "boolean", "default": false },
              "gridDivisions": { "type": "integer", "minimum": 2 },
              "axes": { "type": "boolean", "default": false },
              "axesSizeM": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "terrain-grid" } },
              "required": ["type"]
            },
            "then": { "required": ["terrainGridPath"] },
            "else": { "required": ["model"] }
          }
        ]
      }
    },
    "main_camera": { "type": "object" },
    "droneTypesPath": { "type": "string", "minLength": 1 },
    "drones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "droneType": { "type": "string", "minLength": 1 },
          "pos": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "hpr": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  }
}
